{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cloudguard-scanner",
          "informationUri": "https://github.com/kaveh8866/CI-CD-Security-Compliance-Scanner",
          "version": "0.1.0",
          "rules": [
            {
              "id": "CG-VULN-005",
              "name": "Prototype pollution",
              "shortDescription": {
                "text": "Prototype pollution"
              },
              "fullDescription": {
                "text": "Upgrade minimist to 1.2.6 or later."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "dependency",
                "severity": "critical",
                "tags": [
                  "security",
                  "ci-cd",
                  "dependency"
                ]
              }
            },
            {
              "id": "CG-VULN-003",
              "name": "Arbitrary code execution through full_load",
              "shortDescription": {
                "text": "Arbitrary code execution through full_load"
              },
              "fullDescription": {
                "text": "Upgrade PyYAML to 5.4 or later and parse untrusted input with safe_load."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "dependency",
                "severity": "critical",
                "tags": [
                  "security",
                  "ci-cd",
                  "dependency"
                ]
              }
            },
            {
              "id": "CG-PIPE-002",
              "name": "pull_request_target with untrusted checkout",
              "shortDescription": {
                "text": "pull_request_target with untrusted checkout"
              },
              "fullDescription": {
                "text": "Run untrusted code under 'pull_request'; keep pull_request_target for label-only workflows."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "pipeline",
                "severity": "critical",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-004",
              "name": "Script injection through event context",
              "shortDescription": {
                "text": "Script injection through event context"
              },
              "fullDescription": {
                "text": "Move the value into an environment variable and reference it as \"$VAR\"."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "pipeline",
                "severity": "critical",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-022",
              "name": "CI job token printed",
              "shortDescription": {
                "text": "CI job token printed"
              },
              "fullDescription": {
                "text": "Remove the echo and mark the variable masked in the project settings."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "pipeline",
                "severity": "high",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-SEC-010",
              "name": "Hard-coded credential assignment",
              "shortDescription": {
                "text": "Hard-coded credential assignment"
              },
              "fullDescription": {
                "text": "Move the value into a CI secret and reference it by name at runtime."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "secret",
                "severity": "high",
                "tags": [
                  "security",
                  "ci-cd",
                  "secret"
                ]
              }
            },
            {
              "id": "CG-VULN-004",
              "name": "Command injection in template",
              "shortDescription": {
                "text": "Command injection in template"
              },
              "fullDescription": {
                "text": "Upgrade lodash to 4.17.21 or later."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "dependency",
                "severity": "high",
                "tags": [
                  "security",
                  "ci-cd",
                  "dependency"
                ]
              }
            },
            {
              "id": "CG-VULN-001",
              "name": "Proxy-Authorization header leak on redirect",
              "shortDescription": {
                "text": "Proxy-Authorization header leak on redirect"
              },
              "fullDescription": {
                "text": "Upgrade requests to 2.31.0 or later."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "dependency",
                "severity": "high",
                "tags": [
                  "security",
                  "ci-cd",
                  "dependency"
                ]
              }
            },
            {
              "id": "CG-VULN-002",
              "name": "Request body not stripped on cross-origin redirect",
              "shortDescription": {
                "text": "Request body not stripped on cross-origin redirect"
              },
              "fullDescription": {
                "text": "Upgrade urllib3 to 2.0.7 or later."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "dependency",
                "severity": "high",
                "tags": [
                  "security",
                  "ci-cd",
                  "dependency"
                ]
              }
            },
            {
              "id": "CG-PIPE-001",
              "name": "Unpinned third-party action",
              "shortDescription": {
                "text": "Unpinned third-party action"
              },
              "fullDescription": {
                "text": "Pin the action to a full 40-character commit SHA; refresh it deliberately."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "pipeline",
                "severity": "high",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-003",
              "name": "Secret interpolated into shell output",
              "shortDescription": {
                "text": "Secret interpolated into shell output"
              },
              "fullDescription": {
                "text": "Pass secrets as environment variables and never echo them; mask them in logs."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "pipeline",
                "severity": "high",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-020",
              "name": "Floating container image",
              "shortDescription": {
                "text": "Floating container image"
              },
              "fullDescription": {
                "text": "Pin the image by digest (@sha256:\u2026) so a rebuild cannot introduce a new base."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "pipeline",
                "severity": "medium",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-021",
              "name": "Remote script piped into a shell",
              "shortDescription": {
                "text": "Remote script piped into a shell"
              },
              "fullDescription": {
                "text": "Verify a checksum or signature before executing downloaded scripts."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "pipeline",
                "severity": "medium",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-023",
              "name": "Commit metadata interpolated into a script",
              "shortDescription": {
                "text": "Commit metadata interpolated into a script"
              },
              "fullDescription": {
                "text": "Quote the value or read it from a file instead of interpolating it into script lines."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "pipeline",
                "severity": "medium",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-DEP-003",
              "name": "Unpinned npm dependency",
              "shortDescription": {
                "text": "Unpinned npm dependency"
              },
              "fullDescription": {
                "text": "Pin left-pad to an exact version; commit the lockfile."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "dependency",
                "severity": "medium",
                "tags": [
                  "security",
                  "ci-cd",
                  "dependency"
                ]
              }
            },
            {
              "id": "CG-DEP-001",
              "name": "Unpinned dependency",
              "shortDescription": {
                "text": "Unpinned dependency"
              },
              "fullDescription": {
                "text": "Pin flask to a reviewed version (==x.y.z) and update it deliberately."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "dependency",
                "severity": "medium",
                "tags": [
                  "security",
                  "ci-cd",
                  "dependency"
                ]
              }
            },
            {
              "id": "CG-PIPE-006",
              "name": "Workflow grants write-all permissions",
              "shortDescription": {
                "text": "Workflow grants write-all permissions"
              },
              "fullDescription": {
                "text": "Declare the minimal permissions per job, starting from 'contents: read'."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "pipeline",
                "severity": "medium",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-005",
              "name": "Remote script piped into a shell",
              "shortDescription": {
                "text": "Remote script piped into a shell"
              },
              "fullDescription": {
                "text": "Download, verify a checksum or signature, then execute the pinned artefact."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "pipeline",
                "severity": "medium",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            },
            {
              "id": "CG-PIPE-007",
              "name": "Unreviewed workflow trigger",
              "shortDescription": {
                "text": "Unreviewed workflow trigger"
              },
              "fullDescription": {
                "text": "Confirm the trigger is required; document the threat model for privileged events."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "pipeline",
                "severity": "low",
                "tags": [
                  "security",
                  "ci-cd",
                  "pipeline"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CG-VULN-005",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "minimist 1.2.0 is below the fixed version 1.2.6 (CVE-2021-44906): minimist is vulnerable to prototype pollution through crafted arguments.."
