# =============================================================================
# CI/CD Security & Compliance Scanner — terraform.tfvars template (OCI)
# =============================================================================
# Copy to `terraform.tfvars` (gitignored), fill in your tenancy values, then:
#   tofu init && tofu fmt -recursive && tofu validate && tofu plan
#
# Never commit the filled file: it carries tenancy/compartment OCIDs and the
# path to your API signing key. The placeholders below use hyphens on purpose so
# they can never be mistaken for a real OCID.

# --- Identity ----------------------------------------------------------------
tenancy_ocid     = "ocid1.tenancy.oc1..your-tenancy-placeholder"
compartment_ocid = "ocid1.compartment.oc1..your-compartment-placeholder"
region           = "eu-frankfurt-1"

# Auth path 1 (recommended): a profile in ~/.oci/config.
config_file_profile = "DEFAULT"

# Auth path 2: inline API-key values instead of a profile.
# user_ocid        = "ocid1.user.oc1..your-user-placeholder"
# fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
# private_key_path = "C:/Users/you/.oci/oci_api_key.pem"

# --- Access ------------------------------------------------------------------
# Content of your PUBLIC key (one line starting with ssh-ed25519), not a path.
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample-placeholder-key operator@example.invalid"

# Your egress IP rather than the open internet: `curl -s https://ifconfig.me`
ssh_allowed_cidr = "203.0.113.10/32"

# The scanner API/dashboard port. It returns findings and accepts scan targets,
# so it must never be world-reachable. Use your own /32, a VPN range or a bastion.
scanner_allowed_cidr = "203.0.113.10/32"
scanner_port         = 8300

# --- Network -----------------------------------------------------------------
vcn_cidr    = "10.7.0.0/16"
subnet_cidr = "10.7.1.0/24"

# --- Sizing ------------------------------------------------------------------
# The scanner is capped at 128 MB / 0.25 CPU and measured at ~19 MB idle. 1 OCPU
# / 6 GB is the smallest A1 shape with comfortable headroom for Docker, an image
# pull and a full scan, and remains inside the Always Free 2 OCPU / 12 GB pool.
# If A1 reports "Out of host capacity" in every AD, the Stage 5 fallback is
# VM.Standard.E2.1.Micro (1 OCPU / 1 GB) — the container is capped at 128 MiB.
instance_shape       = "VM.Standard.A1.Flex"
instance_ocpus       = 1
instance_memory_gbs  = 6
boot_volume_size_gbs = 50

# Leave null to take the first availability domain; pin AD-2 if A1 capacity is
# scarce in your region ("Out of host capacity").
availability_domain = "example:EU-FRANKFURT-1-AD-2"

# --- Naming ------------------------------------------------------------------
project_name = "cloudguard-scanner"
environment  = "dev"
