# =============================================================================
# CI/CD Security & Compliance Scanner — environment template
# =============================================================================
# Copy to `.env` (gitignored) and replace every value before pointing this at a
# real repository. The values below are publicly known placeholders: they exist
# so the stack starts and the smoke test can run, not so you can skip rotation.

# --- Service binding ---------------------------------------------------------
# Loopback by default. The published OCI host sets 0.0.0.0 and restricts 8300 to
# one operator /32 in the security list; the API has no authentication, so never
# widen that rule.
SCANNER_BIND_ADDRESS=127.0.0.1
SCANNER_HOST_PORT=8300
SCANNER_POLICY_FILE=/etc/scanner/policies/compliance.toml

# --- Scan scope --------------------------------------------------------------
# Colon-separated allowlist enforced by the API; the container never resolves a
# target outside these roots.
SCANNER_ALLOWED_ROOTS=/scan:/etc/scanner
# Host path mounted read-only at /scan.
SCANNER_WORKSPACE=../configs

# --- Gate behaviour ----------------------------------------------------------
# Minimum severity that fails the run: info | low | medium | high | critical.
SCANNER_FAIL_ON=high
SCANNER_LOG_LEVEL=info

# --- Notifications (Stage 4+) ------------------------------------------------
# Mock endpoints: nothing is sent until you replace them.
SLACK_WEBHOOK_URL=https://hooks.slack.example.com/services/EXAMPLE/EXAMPLE/PLACEHOLDER
ALERT_EMAIL=security@example.com

# --- OCI (Stage 2, OpenTofu) -------------------------------------------------
# Hyphenated placeholders so they can never be mistaken for live OCIDs.
OCI_REGION=eu-frankfurt-1
OCI_TENANCY_OCID=ocid1.tenancy.oc1..placeholder-not-a-real-ocid
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..placeholder-not-a-real-ocid
OCI_AVAILABILITY_DOMAIN=example:EU-FRANKFURT-1-AD-2
OCI_INSTANCE_SHAPE=VM.Standard.A1.Flex   # deployed fallback: VM.Standard.E2.1.Micro
TZ=UTC
